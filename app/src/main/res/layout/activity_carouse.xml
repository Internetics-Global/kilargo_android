<?xml version="1.0" encoding="utf-8"?>

<kilargo_android.internetics.com.kilargo.widget.BaseFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:background="#202020"
              android:layout_width="match_parent"
              android:layout_height="match_parent">



    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <kilargo_android.internetics.com.kilargo.widget.HackyViewPager
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/view_pager"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:scrollbars="horizontal"
            android:layout_height="match_parent" />

        <ImageView
            android:layout_marginLeft="32dp"
            android:scaleType="fitCenter"
            android:layout_width="12dp"
            android:layout_height="24dp"
            android:id="@+id/pager_left_arrow"
            android:layout_gravity="left|center_vertical"
            android:background="@drawable/left_arrow_white_scrollview"/>

        <ImageView
            android:layout_marginRight="32dp"
            android:scaleType="fitCenter"
            android:layout_width="12dp"
            android:layout_height="24dp"
            android:id="@+id/pager_right_arrow"
            android:layout_gravity="right|center_vertical"
            android:background="@drawable/right_arrow_white_scrollview"/>

    </FrameLayout>

    <ImageButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|top"
        android:id="@+id/close_button"
        android:padding="20dp"
        android:background="@null"
        android:src="@drawable/close"/>

    <ImageView
        android:layout_marginRight="60dp"
        android:layout_gravity="center_vertical|right"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="fitCenter"
        android:src="@drawable/rotate_please"
        android:visibility="invisible"
        android:id="@+id/rotation_instruction_imageView"/>



</kilargo_android.internetics.com.kilargo.widget.BaseFrameLayout>
