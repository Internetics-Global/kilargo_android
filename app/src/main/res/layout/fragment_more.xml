<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#2E3142"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <de.hdodenhof.circleimageview.CircleImageView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/avatar_image"
        android:layout_marginTop="20dp"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/left_menu_profile"
        android:layout_centerHorizontal="true"
        app:border_width="0dp"
        app:border_color="#727272"/>

    <TextView
        android:layout_below="@+id/avatar_image"
        android:id="@+id/clerk_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#00000000"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:text="Default" />
    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/clerk_name"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp">

            <Button
                android:id="@+id/button_setting_setting"
                style="@style/button_setting_list_item"
                android:text="Settings"
                />
            <Button
                android:id="@+id/button_setting_about"
                style="@style/button_setting_list_item"
                android:text="About"
                />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_below="@id/scrollview"
        android:id="@+id/version_info"
        android:gravity="center"
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="version"
        android:layout_marginTop="40dp"
        />

</RelativeLayout>
