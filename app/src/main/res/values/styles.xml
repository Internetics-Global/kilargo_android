<resources>

    <style name="AppTheme" parent="@style/MaterialDesignLibraryTheme.Light">
        <item name="colorPrimary">#3f51b5</item>
        <item name="colorPrimaryDark">#303f9f</item>
        <item name="droppyMenuItemStyle">@style/customMenuItem</item>
    </style>

    <style name="button_setting_list_item">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#00FFFFFF</item>
        <item name="android:padding">5dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:textSize">14sp</item>
        <item name="android:drawableRight">@drawable/right_arrow</item>
    </style>


    <style name="customMenuItem" parent="Droppy.DroppyMenuItem">
        <item name="android:layout_width">300dp</item>
    </style>

</resources>
